{
  "name": "dsh-think-game",
  "version": "0.2.0",
  "private": true,
  "description": "A tiny Breakout / Snake / Reflex / 2048 / Memory / Stack / Flappy arcade that lives inside streaming reasoning and pauses when the answer starts.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "mini-games",
    "breakout",
    "snake",
    "reaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorthGateChat/dsh-think-game.git"
  },
  "homepage": "https://github.com/NorthGateChat/dsh-think-game#readme",
  "bugs": {
    "url": "https://github.com/NorthGateChat/dsh-think-game/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:debug": "node debug/build.mjs",
    "pretest": "node debug/build.mjs",
    "test": "node test/test-client-contract.mjs && node test/test-adapter.mjs && node test/test-debug-page.mjs",
    "check": "node --check client.js && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}

